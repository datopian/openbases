#!/usr/bin/env bash
# Refuse a direct push to main, and refuse to push new client or operational
# data to a public repository.
#
# Compensating control for ADR-0016: branch protection is unavailable on the
# current GitHub plan. This hook stops the accidental case, which is the common
# one. It is not a security control — a determined actor can pass --no-verify —
# and it is not a substitute for protected branches.
set -uo pipefail

protected="main"
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/$protected" ]; then
    echo "refusing to push directly to $protected." >&2
    echo >&2
    echo "Every change belongs to a Bead and arrives through a pull request:" >&2
    echo "  bd ready                       # pick unblocked work" >&2
    echo "  git switch -c bead/<id>-<slug>" >&2
    echo "  gh pr create" >&2
    echo >&2
    echo "If this is a recorded bootstrap or break-glass event, push with" >&2
    echo "--no-verify and open the follow-up pull request in the same session." >&2
    exit 1
  fi
done

# The repository is public. gitleaks and GitHub push protection look for
# credentials; a client's name and a Meet space code are not credentials, and
# once pushed they are public and cached whatever happens next. CI checks this
# too and CI is the control that counts -- this is here because a local refusal
# costs 0.2s and a public one cannot be taken back.
root="$(git rev-parse --show-toplevel)"
if [ -f "$root/scripts/check_disclosure.py" ]; then
  if ! python3 "$root/scripts/check_disclosure.py"; then
    echo >&2
    echo "refusing to push: see the finding above." >&2
    echo "Business records belong in the deployment's database, not in a" >&2
    echo "migration; identifiers belong in event_sources or in deployment" >&2
    echo "configuration." >&2
    exit 1
  fi
fi

exit 0
