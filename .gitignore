# Build output
/bin/
/dist/
apps/web/dist/
*.test
coverage.out

# Dependencies
node_modules/

# Secrets — never committed. Host secrets use SOPS/age; the age private key
# lives on the host, not here.
.env
.env.*
!.env.example
*.pem
*.key
!*.pub
*.p12
credentials.json
client_secret*.json
service-account*.json

# Infrastructure state. Remote state is configured per environment; local state
# would contain secret values.
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
crash.log

# Local runtime
.beads/
*.sqlite
.DS_Store

# Pinned toolchain installed by scripts/bootstrap.sh
.toolchain/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# OpenTofu plan artefacts are encrypted but still not for the repository.
tfplan
*.tfplan

# Committed tfvars hold NON-SECRET environment config only: account and zone
# identifiers, hostnames, and the Access allow-list. ADR-0015 requires
# persistent configuration to live in Git or production cannot be rebuilt from
# code. Credentials come from the environment and are never written here.
# A secrets-bearing override, if one is ever needed, uses this name:
infra/tofu/**/secret.auto.tfvars
