#cloud-config
# First-boot bootstrap for a Workgraph node.
#
# This exists so the node can reach Cloudflare without anything reaching the
# node. The firewall has no inbound rules, so there is no SSH to configure from;
# the host dials out and the tunnel becomes the only path in.
#
# Deliberately minimal. Real hardening — users, auditd, cgroups, execution
# cells, rootless containers — is WP-B2's Ansible, which runs over this
# connection once it exists. Anything added here is unmanaged by Ansible.

package_update: true
package_upgrade: false

write_files:
  - path: /usr/local/sbin/bootstrap-cloudflared.sh
    permissions: "0700"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      # Install and start the Cloudflare Tunnel connector.
      #
      # Escaping note. templatefile interpolates only the dollar-brace
      # sequence, so a shell variable reference must have its dollar doubled
      # here. Command substitution and arithmetic expansion are NOT template
      # syntax and are written plainly; doubling their dollar renders it
      # literally, and a bare doubled dollar is the shell's PID, which is a
      # syntax error. This comment deliberately avoids the literal sequences,
      # because a comment containing them breaks the template too.
      set -euo pipefail
      exec > >(tee -a /var/log/workgraph-bootstrap.log) 2>&1
      echo "=== workgraph bootstrap $(date -Is) ==="

      VERSION="${cloudflared_version}"
      WANT="${cloudflared_sha256}"
      DEB="/tmp/cloudflared.deb"
      URL="https://github.com/cloudflare/cloudflared/releases/download/$${VERSION}/cloudflared-linux-amd64.deb"

      # Pinned release and verified checksum, same discipline as versions.lock:
      # a release artefact, never "latest", and a mismatch aborts.
      for attempt in 1 2 3 4 5; do
        if curl -fsSL --retry 3 -o "$${DEB}" "$${URL}"; then break; fi
        echo "download attempt $${attempt} failed; retrying"
        sleep $(( attempt * 5 ))
      done

      GOT="$(sha256sum "$${DEB}" | awk '{print $1}')"
      if [ "$${GOT}" != "$${WANT}" ]; then
        echo "CHECKSUM MISMATCH for cloudflared $${VERSION}" >&2
        echo "  expected: $${WANT}" >&2
        echo "  actual:   $${GOT}" >&2
        exit 1
      fi
      echo "checksum verified"

      dpkg -i "$${DEB}"
      rm -f "$${DEB}"

      # Use cloudflared's own service installer rather than a hand-written unit.
      # It owns the unit's ExecStart and service type; writing our own means
      # guessing at both, and guessing wrong fails silently on a host with no
      # inbound path to debug from.
      cloudflared service install '${tunnel_token}'

      # Hardening goes in a drop-in, so an upgrade that rewrites the vendor unit
      # does not silently drop it.
      mkdir -p /etc/systemd/system/cloudflared.service.d
      cat > /etc/systemd/system/cloudflared.service.d/10-hardening.conf <<'HARDENING'
      [Service]
      NoNewPrivileges=true
      PrivateTmp=true
      PrivateDevices=true
      ProtectSystem=strict
      ProtectHome=true
      ProtectKernelTunables=true
      ProtectKernelModules=true
      ProtectControlGroups=true
      ProtectProc=invisible
      RestrictSUIDSGID=true
      RestrictNamespaces=true
      RestrictRealtime=true
      LockPersonality=true
      MemoryDenyWriteExecute=true
      CapabilityBoundingSet=
      AmbientCapabilities=
      HARDENING

      systemctl daemon-reload
      systemctl restart cloudflared
      sleep 5
      systemctl is-active cloudflared && echo "cloudflared active" || {
        echo "cloudflared FAILED to start" >&2
        systemctl status cloudflared --no-pager >&2 || true
        journalctl -u cloudflared --no-pager -n 50 >&2 || true
        exit 1
      }
      echo "=== bootstrap complete $(date -Is) ==="

runcmd:
  - [ bash, /usr/local/sbin/bootstrap-cloudflared.sh ]

# A failed bootstrap must be diagnosable without a shell, since there is no
# inbound path to this host. The log above is the only record; WP-B2 ships it
# off-host once the tunnel exists.
final_message: "workgraph node bootstrap finished after $UPTIME seconds"
