# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
# Secrets are NOT set here — HCLOUD_TOKEN and CLOUDFLARE_API_TOKEN come from
# the environment, and the state passphrase from TF_VAR_state_encryption_passphrase.

cloudflare_account_id = ""
cloudflare_zone_id    = ""
hostname              = "work.openbases.com"

# Empty denies everyone. Add the pilot users before expecting to log in.
access_allowed_emails = []

# Break-glass only. Leave empty: the origin is reached through Cloudflare Tunnel.
admin_ssh_cidrs = []
