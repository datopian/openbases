# Model access for the {{ item.name }} cell. Mode 0600, cell user only.
#
# Claude Code reads its endpoint and credentials from the environment. Pointing
# it at the gateway means the Anthropic key never reaches this machine.
ANTHROPIC_BASE_URL=https://gateway.ai.cloudflare.com/v1/{{ cloudflare_account_id }}/{{ ai_gateway_prefix }}-{{ item.trust_domain | regex_replace('^client-.*$', 'client') }}/anthropic

# AI Gateway supplies the Anthropic credential, so this value is not used as an
# API key. Claude Code requires the variable to be set, and reusing the gateway
# token keeps one secret on the box rather than two.
ANTHROPIC_API_KEY={{ ai_gateway_token }}
# Quoted deliberately. The value contains spaces, and Gas Town starts an agent
# through a shell, so an unquoted value is split on whitespace: the line becomes
# an assignment followed by an attempt to run "Bearer" as a command, the header
# never reaches the gateway, and the failure surfaces as a 401 that looks like a
# bad token rather than a malformed file.
ANTHROPIC_CUSTOM_HEADERS="cf-aig-authorization: Bearer {{ ai_gateway_token }}"

WG_CELL={{ item.name }}
WG_TRUST_DOMAIN={{ item.trust_domain }}
