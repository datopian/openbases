# Managed by Ansible (WP-C2). Contains a credential; do not copy off the host.
WG_ENV={{ control_api_environment }}
WG_LISTEN_ADDR=127.0.0.1:{{ control_api_port }}
# The DSN without its password. The password arrives as a systemd credential
# and is substituted at startup, percent-encoded — an unencoded '@' or '/' in a
# rotated password would terminate the authority early and connect somewhere
# else entirely rather than reporting a bad password.
WG_DATABASE_URL_TEMPLATE=postgres://workgraph_app:{password}@127.0.0.1:5432/workgraph?sslmode=disable
WG_ACCESS_TEAM_DOMAIN={{ control_api_access_team_domain }}
WG_ACCESS_AUD={{ control_api_access_aud }}
# Where a browser reaches the interface. Used to build the verification URI a
# device grant asks somebody to open, so it is configured rather than derived
# from a request header -- that URI is the one thing a human is asked to trust.
WG_APP_BASE_URL={{ control_api_app_base_url | default('') }}
# WG_GITHUB_WEBHOOK_SECRET is deliberately absent: it is a systemd credential
# now. The application prefers the credential and falls back to this variable,
# so removing the line is what actually completes the migration.

# Reconciliation needs the App itself, not just the webhook secret: recovering a
# delivery that never arrived means asking GitHub for current state.
WG_GITHUB_APP_ID={{ control_api_github_app_id }}
WG_GITHUB_INSTALLATION_ID={{ control_api_github_installation_id }}
WG_GITHUB_PRIVATE_KEY_PATH={{ control_api_github_key_path }}

# The AUD of the Access application fronting the git-credential endpoint.
# Accepted only on that path, so this token cannot become a general API
# credential.
WG_CELL_ACCESS_AUD={{ control_api_cell_access_aud | default('') }}

# The AUD of the Access application fronting the agent-health endpoint, which
# the deterministic witness reports to (ADR-0019). Separate from the one above
# on purpose: same token, different power.
WG_CELL_HEALTH_ACCESS_AUD={{ control_api_cell_health_access_aud | default('') }}

# And the budget check the dispatcher asks before slinging (wg-qw1). A third
# audience for a third power, and the smallest of them: it only reads.
#
# Empty until the Access application exists. The endpoint then rejects every
# caller rather than accepting any audience, which is the correct direction to
# fail — a budget check that let anything through would be worse than none.
WG_CELL_BUDGET_ACCESS_AUD={{ control_api_cell_budget_access_aud | default('') }}

# How old imported spend may be and still be trusted for a budget decision
# (wg-qw1). Beyond it the check REFUSES rather than guessing, because an allow
# granted on stale data is confidently wrong.
#
# Configuration rather than a constant, for the reason the monitor's thresholds
# are: a threshold that needs a release to change is one that gets worked around
# instead — and the way it gets worked around here is --no-budget-check on every
# dispatch, which switches enforcement off entirely rather than loosening it.
#
# "0" disables the staleness check while keeping the ceilings, which is the right
# setting until wg-costimport is running (wg-oku).
# The AUD of the Access application fronting /v1/node/, the execution nodes'
# side of the work queue (WP-D2/E3). A reserved prefix rather than one exact
# path: one of those endpoints carries a job id, and the endpoints a PERSON uses
# to create work live under /v1/work, deliberately not here.
WG_CELL_WORK_ACCESS_AUD={{ control_api_cell_work_access_aud | default('') }}

# Pub/Sub push authentication (ADR-0026). The audience is the endpoint itself,
# and must match what the subscription was created with — a mismatch refuses
# every delivery. Empty leaves the endpoint unregistered entirely, which is the
# right default: a receiver with no audience would accept any Google-signed
# token.
WG_PUBSUB_PUSH_AUDIENCE={{ control_api_pubsub_push_audience | default('') }}
WG_PUBSUB_PUSH_SERVICE_ACCOUNT={{ control_api_pubsub_push_service_account | default('') }}

WG_BUDGET_MAX_STALENESS={{ control_api_budget_max_staleness | default('2h') }}
