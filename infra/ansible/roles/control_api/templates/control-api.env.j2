# Managed by Ansible (WP-C2). Contains a credential; do not copy off the host.
WG_ENV={{ control_api_environment }}
WG_LISTEN_ADDR=127.0.0.1:{{ control_api_port }}
WG_DATABASE_URL=postgres://workgraph_app:{{ postgresql_app_password }}@127.0.0.1:5432/workgraph?sslmode=disable
WG_ACCESS_TEAM_DOMAIN={{ control_api_access_team_domain }}
WG_ACCESS_AUD={{ control_api_access_aud }}
WG_GITHUB_WEBHOOK_SECRET={{ control_api_github_webhook_secret }}

# Reconciliation needs the App itself, not just the webhook secret: recovering a
# delivery that never arrived means asking GitHub for current state.
WG_GITHUB_APP_ID={{ control_api_github_app_id }}
WG_GITHUB_INSTALLATION_ID={{ control_api_github_installation_id }}
WG_GITHUB_PRIVATE_KEY_PATH={{ control_api_github_key_path }}

# The AUD of the Access application fronting the git-credential endpoint.
# Accepted only on that path, so this token cannot become a general API
# credential.
WG_CELL_ACCESS_AUD={{ control_api_cell_access_aud | default('') }}
