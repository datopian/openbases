[Unit]
Description=Workgraph reconciliation
# Documentation= must be a URI; a bare phrase makes systemd log
# "Invalid URL, ignoring" on every start.
Documentation=https://github.com/datopian/company-workgraph#wp-d3
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User={{ control_api_user }}
Group={{ control_api_user }}
EnvironmentFile=/etc/workgraph/control-api.env

# The database password, as a credential rather than in the environment — the
# same reasoning as control-api.service. Without this, reconciliation cannot
# build a DSN at all now that the password has left the environment file.
LoadCredential=db_app_password:/etc/workgraph/credentials/db_app_password
{% if control_api_local_github_key | default('') | length > 0 %}
LoadCredential=github_app_private_key:{{ control_api_github_key_path }}
{% endif %}

ExecStart={{ control_api_reconcile_binary }}

# Same hardening as the API. Reconciliation holds the App private key and can
# write projections, so it is not a lesser process for running on a timer.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
