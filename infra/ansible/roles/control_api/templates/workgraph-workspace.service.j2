[Unit]
Description=Workgraph Google Workspace reconciliation and source ingestion
Documentation=https://github.com/datopian/company-workgraph#wp-h1
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User={{ control_api_user }}
Group={{ control_api_user }}
EnvironmentFile=/etc/workgraph/control-api.env

LoadCredential=db_app_password:/etc/workgraph/credentials/db_app_password
# The gateway token, for extracting candidates from a registered source. As a
# credential rather than in the environment, for the reason every other secret
# here is: a token in an environment file is a token in every process listing
# and crash dump on the node.
{% if control_api_ai_gateway_token | default('') | length > 0 %}
LoadCredential=ai_gateway_token:/etc/workgraph/credentials/ai_gateway_token
{% endif %}
Environment=WG_AI_GATEWAY_BASE_URL={{ control_api_ai_gateway_base_url | default('') }}

# The delegated identity. A service account cannot hold Drive or Meet resources
# of its own, so every call is made as a real user in the domain.
Environment=WG_GOOGLE_SUBJECT={{ control_api_google_subject }}
Environment=WG_GOOGLE_PUBSUB_TOPIC={{ control_api_google_topic }}
Environment=GOOGLE_APPLICATION_CREDENTIALS={{ control_api_google_key_path }}

# Publishing accepted candidates as beads (WP-H4). The node name is how the
# publisher tells a graph on this host from one recorded elsewhere: it must
# match what the registry stored, which is inventory_hostname.
Environment=WG_NODE_NAME={{ inventory_hostname }}
# /usr/local/bin/bd is where beads_hq installs the pinned binary, hardcoded
# there too rather than behind a variable that could name a different one.
Environment=WG_BEADS_BINARY=/usr/local/bin/bd

# The repository accepted knowledge records are proposed in, as owner/name.
#
# Empty until the GitHub App installation includes it: the App reaches ten
# repositories and company-workgraph is not one of them, so setting this before
# the grant would turn every hourly pass red on a 404. Empty means beads are
# published and no Markdown is, and the pass says so in one line rather than
# leaving "no pull request appeared" indistinguishable from "nothing was
# accepted".
Environment=WG_KNOWLEDGE_REPO={{ control_api_knowledge_repo | default('') }}
Environment=WG_KNOWLEDGE_BASE={{ control_api_knowledge_base | default('main') }}

ExecStart={{ control_api_workspace_binary }}

# This key can read every file in three shared drives as any user in the
# domain. Same hardening as the API, and ProtectSystem=strict means the key is
# reachable only because it is under /etc/workgraph, which is not writable here.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
# The graphs, which publication writes to. ProtectSystem=strict makes the whole
# filesystem read-only, so without this `bd create` fails on a directory the
# service user owns -- which reads as a permissions problem and is not one.
ReadWritePaths={{ beads_hq_root | default('/srv/graphs') }}
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
