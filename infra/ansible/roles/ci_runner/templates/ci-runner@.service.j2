# Managed by Ansible. One instance per concurrent job: ci-runner@1, ci-runner@2.
[Unit]
Description=GitHub Actions runner %i (ephemeral)
Documentation=https://github.com/datopian/workgraph#ci-runner
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User={{ ci_runner_user }}
Group={{ ci_runner_user }}
WorkingDirectory={{ ci_runner_root }}

Environment=CI_RUNNER_ORG={{ ci_runner_org }}
Environment=CI_RUNNER_GROUP={{ ci_runner_group }}
Environment=CI_RUNNER_LABELS={{ ci_runner_labels }}
Environment=CI_RUNNER_ROOT={{ ci_runner_root }}

{% if ci_runner_github_app_id | default('') not in ['', 'UNSET'] %}
LoadCredential=github_app_id:/etc/ci-runner/credentials/github_app_id
LoadCredential=github_app_installation_id:/etc/ci-runner/credentials/github_app_installation_id
LoadCredential=github_app_private_key:/etc/ci-runner/credentials/github_app_private_key
{% endif %}
{% if ci_runner_github_pat | default('') not in ['', 'UNSET'] %}
LoadCredential=github_pat:/etc/ci-runner/credentials/github_pat
{% endif %}

ExecStart=/usr/local/bin/wg-register-runner %i

# The runner exits after ONE job because it registers --ephemeral. Restarting is
# the normal path, not error recovery: each restart registers a fresh runner, so
# no job inherits anything from the one before.
Restart=always
RestartSec=5s

# Deliberately light hardening compared with the rest of this repository's
# units. A CI runner's whole job is to execute arbitrary build tooling —
# compilers, containers, package managers — and ProtectSystem=strict or a
# SystemCallFilter would break legitimate workflows in ways that look like
# mysterious CI failures. The isolation here is the machine: it holds nothing
# but CI, in its own Hetzner project, with no inbound port.
NoNewPrivileges=false
KillMode=process
TimeoutStopSec=5min

[Install]
WantedBy=multi-user.target
