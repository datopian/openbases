#!/usr/bin/env bash
# Register one ephemeral GitHub Actions runner and run it for exactly one job.
#
#   wg-register-runner <instance-name>
#
# Managed by Ansible. Run by a systemd unit with Restart=always, so the sequence
# per job is: mint a registration token, configure, run one job, deregister,
# exit, and be restarted for the next.
#
# WHY EPHEMERAL. A long-lived runner carries whatever the last job left behind:
# files outside the work directory, background processes, a poisoned tool cache,
# a modified git config. On a host shared by every repository in the
# organisation, that is one repository's workflow influencing another's build.
# --ephemeral makes the registration single-use and the runner exit after one
# job, so the next job starts from a runner that has never executed anything.
#
# WHAT IT IS NOT. This is not container isolation. The job still runs as this
# user on this kernel, and a job that deliberately attacks the host can affect
# later ones. Full isolation means a container or a VM per job, which is the
# next step if untrusted code ever runs here. Today the group is scoped to
# private repositories whose contributors already have commit access, so the
# threat is accident rather than malice — worth being explicit about, because
# "ephemeral" is easy to read as "sandboxed" and it is not.
set -uo pipefail

INSTANCE="${1:?usage: wg-register-runner <instance-name>}"
ORG="${CI_RUNNER_ORG:?CI_RUNNER_ORG is not set}"
LABELS="${CI_RUNNER_LABELS:-self-hosted,linux,x64}"
GROUP="${CI_RUNNER_GROUP:-Default}"
ROOT="${CI_RUNNER_ROOT:-/opt/actions-runner}"
WORKDIR="$ROOT/$INSTANCE"

read_credential() {
  local name="$1"
  if [ -n "${CREDENTIALS_DIRECTORY:-}" ] && [ -r "$CREDENTIALS_DIRECTORY/$name" ]; then
    tr -d '\r\n' < "$CREDENTIALS_DIRECTORY/$name"
  fi
}

# ---------------------------------------------------------------------------
# A registration token, which lasts an hour
# ---------------------------------------------------------------------------
#
# Minted per job rather than stored. The long-lived credential that mints it
# never leaves this script's memory, and the token it produces expires whether
# or not anything cleans up.
mint_installation_token() {
  local app_id="$1" install_id="$2" key_file="$3"
  local now iat exp header payload unsigned sig jwt
  now=$(date +%s); iat=$((now - 60)); exp=$((now + 540))

  b64() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
  header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64)
  payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$iat" "$exp" "$app_id" | b64)
  unsigned="$header.$payload"
  sig=$(printf '%s' "$unsigned" | openssl dgst -sha256 -sign "$key_file" -binary | b64)
  jwt="$unsigned.$sig"

  curl -fsS -X POST \
    -H "Authorization: Bearer $jwt" \
    -H "Accept: application/vnd.github+json" \
    "https://api.github.com/app/installations/${install_id}/access_tokens" \
    | python3 -c 'import json,sys; print(json.load(sys.stdin)["token"])'
}

APP_ID="$(read_credential github_app_id)"
INSTALL_ID="$(read_credential github_app_installation_id)"
PAT="$(read_credential github_pat)"
KEY_FILE="${CREDENTIALS_DIRECTORY:-}/github_app_private_key"

AUTH=""
if [ -n "$APP_ID" ] && [ "$APP_ID" != "UNSET" ] && [ -r "$KEY_FILE" ]; then
  AUTH="$(mint_installation_token "$APP_ID" "$INSTALL_ID" "$KEY_FILE")" || {
    echo "could not mint an installation token from the GitHub App" >&2; exit 1; }
elif [ -n "$PAT" ] && [ "$PAT" != "UNSET" ]; then
  AUTH="$PAT"
else
  echo "no GitHub credential: set the App (preferred) or a PAT in infra/secrets/ci.enc.yaml" >&2
  exit 1
fi

REG_TOKEN="$(curl -fsS -X POST \
  -H "Authorization: Bearer $AUTH" \
  -H "Accept: application/vnd.github+json" \
  "https://api.github.com/orgs/${ORG}/actions/runners/registration-token" \
  | python3 -c 'import json,sys; print(json.load(sys.stdin)["token"])')" || {
    echo "could not mint a runner registration token for org ${ORG}" >&2; exit 1; }
unset AUTH

# ---------------------------------------------------------------------------
# A clean work directory, every time
# ---------------------------------------------------------------------------
#
# Removed and recreated rather than reused. --ephemeral guarantees a fresh
# REGISTRATION; it does not promise the previous job left no files behind, and
# a stale checkout is how a build passes against code nobody pushed.
rm -rf "$WORKDIR"
mkdir -p "$WORKDIR"
cd "$WORKDIR" || exit 1
tar xzf "$ROOT/runner.tar.gz"

./config.sh \
  --url "https://github.com/${ORG}" \
  --token "$REG_TOKEN" \
  --name "$(hostname)-${INSTANCE}" \
  --runnergroup "$GROUP" \
  --labels "$LABELS" \
  --work _work \
  --ephemeral \
  --unattended \
  --replace || { echo "runner configuration failed" >&2; exit 1; }
unset REG_TOKEN

# run.sh exits after one job because of --ephemeral. systemd restarts the unit,
# which comes back through this script and registers again.
exec ./run.sh
