# How this cell deploys to PortalJS Arc. Mode 0600, cell user only.
#
# Written only when a token exists, so a deploy without one leaves the cell
# exactly as it was rather than installing an empty credential that fails at
# the far end with an unhelpful 401.
PORTALJS_TOKEN={{ portaljs_arc_token }}
{% if portaljs_arc_api %}PORTALJS_API={{ portaljs_arc_api }}
{% endif %}