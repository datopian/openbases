# How this cell reaches the control API. Mode 0600, cell user only.
#
# An Access service token, NOT a GitHub credential. It authenticates the cell to
# the control plane, which then decides whether to mint a git token and for
# which repository. The token is accepted on exactly one path, so possession of
# it does not grant access to the rest of the API.
WG_CONTROL_API={{ control_api_url }}
WG_ACCESS_CLIENT_ID={{ access_service_client_id }}
WG_ACCESS_CLIENT_SECRET={{ access_service_client_secret }}
