#!/usr/bin/env bash
# git credential helper: fetch a short-lived, repository-scoped GitHub token.
#
# The App private key is NOT on this machine and must never be. It can mint
# tokens for every installed repository, including restricted client work, so a
# single compromised cell would otherwise compromise all of them. The control
# node holds the key and hands out narrow, hour-long tokens instead.
#
# git invokes this with "get" and key=value lines on stdin, and reads username
# and password from stdout. It ignores anything else printed there, so failures
# must be silent to git and visible in the log.
set -uo pipefail

[ "${1:-}" = "get" ] || exit 0

declare -A q
while IFS='=' read -r k v; do
  [ -n "$k" ] || break
  q["$k"]="$v"
done

[ "${q[host]:-}" = "github.com" ] || exit 0

# path is "owner/repo.git"; the API wants the repository name alone, and scopes
# the token to exactly that repository.
repo="${q[path]:-}"
repo="${repo##*/}"
repo="${repo%.git}"
[ -n "$repo" ] || exit 0

CREDS={{ cells_root }}/{{ item.name }}/.credentials/control-api.env
# shellcheck disable=SC1090
[ -r "$CREDS" ] || { echo "git-credential-workgraph: no control-plane credentials" >&2; exit 0; }
. "$CREDS"

response=$(curl -sS --max-time 20 \
  -X POST "${WG_CONTROL_API}/v1/integrations/github/installation-token" \
  -H "CF-Access-Client-Id: ${WG_ACCESS_CLIENT_ID}" \
  -H "CF-Access-Client-Secret: ${WG_ACCESS_CLIENT_SECRET}" \
  -H "Content-Type: application/json" \
  --data "{\"repository\":\"${repo}\"}" 2>/dev/null) || {
    echo "git-credential-workgraph: control API unreachable" >&2
    exit 0
  }

token=$(printf '%s' "$response" | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("token",""))
except Exception: print("")' 2>/dev/null)

if [ -z "$token" ]; then
  # The response is deliberately not echoed. On failure it is an error object,
  # but on success it holds a live credential, and one shared log line is all it
  # takes to leak it into a transcript.
  echo "git-credential-workgraph: no token issued for ${repo}" >&2
  exit 0
fi

echo "username=x-access-token"
echo "password=${token}"
